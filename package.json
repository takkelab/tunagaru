{
  "name": "tunagaru",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "postinstall": "node tools/secrets/gitleaks.mjs --install",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check . && node tools/lint/arch.mjs && node tools/lint/file-length.mjs && node tools/lint/docs.mjs && markdownlint-cli2 && node tools/lint/cassette-secrets.mjs && node tools/lint/fixture-provenance.mjs",
    "lint:arch": "node tools/lint/arch.mjs",
    "secrets": "node tools/secrets/gitleaks.mjs git --config .gitleaks.toml --redact --no-banner .",
    "fix": "biome check --write .",
    "format": "biome format --write .",
    "gen:schema": "node tools/schema/gen.mjs",
    "test": "node tools/scripts/test.mjs",
    "e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && node tools/schema/gen.mjs --check && pnpm test",
    "cassette:record": "node tools/cassette/record.mjs",
    "test:live": "node tools/scripts/stub.mjs test:live 2",
    "eval": "node tools/scripts/stub.mjs eval 9",
    "metrics": "node tools/metrics/metrics.mjs",
    "dev": "node tools/scripts/stub.mjs dev 6",
    "cli": "node tools/scripts/stub.mjs cli 3",
    "db:migrate": "node tools/scripts/stub.mjs db:migrate 4",
    "db:seed:fixture": "node tools/scripts/stub.mjs db:seed:fixture 7",
    "seed:wikidata": "node tools/scripts/stub.mjs seed:wikidata 10",
    "spike:ux": "node spike/a-ux/serve.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "dependency-cruiser": "18.7.2",
    "lefthook": "2.2.2",
    "markdownlint-cli2": "0.24.1",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
